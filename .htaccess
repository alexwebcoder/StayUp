### BEGIN HTTPS AND NON-WWW REDIRECT ###
# Force HTTPS and remove WWW in one efficient step
RewriteEngine On

# If NOT HTTPS OR if domain starts with WWW
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.stayup\.com$ [NC]
RewriteRule ^(.*)$ https://stayup.com/$1 [L,R=301,NE]

# Global Security Headers
Header always set Content-Security-Policy "upgrade-insecure-requests;"
### END HTTPS AND NON-WWW REDIRECT ###